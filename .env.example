# Токен от BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чата менеджеров для уведомлений о новых заказах
STAFF_CHAT_ID=your_staff_chat_id_here

# JSON-ключ от Service Account (вставлять целиком, можно в одну строку)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", "private_key_id": "...", "private_key": "...", "client_email": "...", "client_id": "...", "auth_uri": "...", "token_uri": "...", "auth_provider_x509_cert_url": "...", "client_x509_cert_url": "..."}'

# Точное название Google Таблицы
SPREADSHEET_NAME=your_spreadsheet_name

# Прямая ссылка на задеплоенный webapp/index.html (потребуется фронтенду)
MINIAPP_URL=https://your-miniapp-url.com
